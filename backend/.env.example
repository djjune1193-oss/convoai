DATABASE_URL=sqlite:///./chatapp.db
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
TAVILY_API_KEY=your_tavily_key_here
AI_CONTEXT_MESSAGE_LIMIT=20
# Comma-separated, e.g. https://yourdomain.com,https://www.yourdomain.com
# Leave as * for local dev.
ALLOWED_ORIGINS=*
# MUST be a real random secret before deploying — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-insecure-secret-change-me-before-deploying
JWT_EXPIRE_DAYS=30
